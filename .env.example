# .env.local 을 만들 때 참고용 — 실제 키 값은 절대 여기(또는 Git)에 넣지 마세요.

# --- Vercel AI Gateway ---
AI_GATEWAY_API_KEY=vck_...

# --- Firebase: 클라이언트(브라우저)용 공개 설정값 ---
# Firebase 콘솔 > 프로젝트 설정 > "내 앱"(웹 앱 추가) > SDK 설정 및 구성 에서 확인.
# NEXT_PUBLIC_ 접두어가 붙은 값은 브라우저에 그대로 노출되는 게 정상이다(Firestore
# 보안 규칙이 실제 접근 권한을 통제한다 — src/lib/firebaseAdmin.ts 상단 주석 참고).
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=...

# --- Firebase: 서버(Admin SDK) 전용 비공개 자격 증명 ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON
# 파일 안의 project_id / client_email / private_key 값을 그대로 옮겨 적는다.
# 절대 커밋하지 말 것 — private_key는 JSON 안에서 "\n"으로 이스케이프된 개행 문자
# 그대로 붙여넣으면 된다(코드에서 다시 실제 개행으로 풀어서 사용한다).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
